{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-lab-30-q7r8",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/index.mjs",
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://labs.996fb.cn"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-lab-family-progress",
      "database_id": "b3d2c512-e532-4cf5-aa50-22237beb77d3",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
