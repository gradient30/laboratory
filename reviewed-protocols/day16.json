{
  "activityId": 16,
  "activityTitle": "塑料尺隔空吸纸",
  "ageProtocols": {
    "4-6": {
      "version": 1,
      "materials": [
        "30厘米干燥圆滑塑料尺1把；干燥羊毛布1块（无羊毛则记录实际布料，不宣称羊毛结论）",
        "平底干燥托盘1只；成人剪刀1把；厘米刻度尺1把；记录纸1张、铅笔1支",
        "白卡片1张与少量胶带（成人做侧面1厘米高度参照，不接触测试尺）；成人计时器1个",
        "同张薄纸成人预剪约1×1厘米纸片2张（基线与摩擦后各1张）"
      ],
      "safety": "不用插座、电线、电源、气球或人体放电；远离电子设备、易燃喷雾和燃气。仅用无裂痕圆滑塑料尺及干净布，温和摩擦不超过本轮20次，不加力追求火花或效果。成人准备和收回小纸，远离口鼻；不吹纸、不凑脸，孩子不操作剪刀。成人计时器远离摩擦区，不用手机靠近带电尺。操作区无风、干燥平稳；无明显现象如实记录，不能改用危险材料。本龄全部摆放、摩擦与靠近由成人做，孩子只观察。",
      "steps": [
        {
          "title": "先看未摩擦尺",
          "action": "成人摆第一张纸。成人在托盘测试位置旁约3厘米外固定参照卡，标出高于纸面约1厘米的位置；塑料尺宽面水平朝下，成人只握未摩擦的一端，从侧面比对间隙，不让尺压纸。未主动摩擦的尺保持约1厘米间隙5秒，看纸是否在接触前移动，随后移开。",
          "actor": "adult",
          "caption": "还没碰到，纸动了吗？",
          "adultNote": "未摩擦不保证完全不带电；基线已动就记下，不宣称干净的前后对照。"
        },
        {
          "title": "远离纸片擦尺子",
          "action": "取走基线纸并另放一张新纸。成人在远离纸片处操作：成人用布在同一约15厘米长尺段同向温和擦20次，每次擦过后抬布回起点，尽量同一速度与压力；不摸这段尺面。",
          "actor": "adult",
          "caption": "只轻擦，不追求火花。",
          "adultNote": "不要在纸旁挥布造成气流。"
        },
        {
          "title": "同样间隙再看",
          "action": "成人摩擦完约5秒后将尺水平放到新纸上方约1厘米，保持5秒，不碰纸。孩子说纸是否先移动；若纸跳起碰尺，立即移走尺，不继续压住。",
          "actor": "adult",
          "caption": "分清纸先动，还是被尺碰了。",
          "adultNote": "1厘米不是必有效距离；没动也不逐步逼近到碰纸。"
        },
        {
          "title": "把两种观察画出来",
          "action": "孩子画基线和摩擦后纸的位置，口述动/没动/不确定。成人标记是否有接触或气流干扰；不把纸不动说成绝对没有电荷。",
          "actor": "child",
          "caption": "不确定也能记录。",
          "adultNote": "成人收齐纸片，擦净收好尺布。"
        }
      ],
      "knowledge": {
        "concepts": [
          "接触前的移动",
          "比较观察",
          "静电不是磁铁"
        ],
        "explanation": "接触并分开布和塑料可能使它们带电，附近纸内的电荷分布可能改变，纸就可能受到吸引。尺子并没有变成磁铁。",
        "limits": "风、手碰和已有电荷会干扰；没看到移动不证明没有作用。一次前后观察不能测电荷数值。",
        "observation": "未主动摩擦与擦后，两张新纸是否在尺碰到前移动。",
        "nextQuestion": "如果尺子先碰纸了，还能叫隔空观察吗？"
      },
      "guide": {
        "goal": "实际辨认接触前纸是否移动，做前后两次观察。",
        "observe": "未主动摩擦与擦过后，纸是否在尺碰到之前移动？",
        "support": "成人做所有操作；孩子从侧面看并口述。",
        "control": "同尺布、同大小新纸、约1厘米间隙、每次看5秒；记录风和接触。",
        "time": "约5–10分钟。",
        "recordFields": [
          "未主动摩擦：动/没动/不确定",
          "摩擦后：接触前是否动",
          "碰纸、气流或没看清"
        ]
      },
