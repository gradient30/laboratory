{
  "activityId": 9,
  "activityTitle": "尺子怎么唱出高低音",
  "ageProtocols": {
    "4-6": {
      "version": 1,
      "materials": [
        "30厘米柔韧、无裂痕、边缘圆滑的塑料尺1把",
        "稳固桌子1张；能平稳盖住桌上尺段的厚书1本",
        "另一把毫米刻度尺1把（只在静止时估计拨幅，测完移开）；记录纸1张、铅笔1支"
      ],
      "safety": "成人全程固定与拨动；孩子只观察或听，不把手或脸伸到桌下尺端。成人检查并固定直尺：仅用边缘圆滑、能温和弯曲的30厘米塑料尺，不用金属薄尺、硬脆尺或有裂痕的尺。稳固桌边操作，成人以厚书和手压住桌上尺段；脸和眼睛远离自由端，旁人不在弹动方向上。最多向下拨约3毫米，不猛弹、不加重物、不用夹具夹手；若难轻弯、异响、滑移或裂痕立即停止。听不清就记录，不靠近耳朵或加大拨幅追声音。",
      "steps": [
        {
          "title": "成人搭好尺子",
          "action": "成人让尺子指定刻度对齐桌边，厚书平放压住桌上尺段，书的前缘靠近桌边且不悬空；手按书本而非伸到活动尺端下方。本次只用12厘米伸出长度。先不碰自由端，孩子看它静止的样子。",
          "actor": "adult",
          "caption": "尺子静着时，先看看。",
          "adultNote": "另一把尺只用于成人静态核对，不留在弹动范围。"
        },
        {
          "title": "保持弯一点但不松手",
          "action": "成人把自由端轻下压约3毫米并保持约1秒，不来回摇；孩子观察此时尺子虽然弯着，却没有自由上下振动。随后成人缓缓放回平位。",
          "actor": "adult",
          "caption": "弯着和来回动，是一回事吗？",
          "adultNote": "只做很小位移；若不好保持就跳过保持阶段，不加大幅度。"
        },
        {
          "title": "松开看振动",
          "action": "成人再轻下拨约3毫米后松开，保持另一只手压稳书。看尺端是否来回动，听是否有声音；等完全停下后再做1次，不追求更响。",
          "actor": "adult",
          "caption": "松手后，尺端怎样动？",
          "adultNote": "有些尺只看到振动而声音弱，这是允许的观察。"
        },
        {
          "title": "说出静止与松开差别",
          "action": "孩子口述或画静止、保持轻弯、松开后三种状态；分别说“看见动／没看清”和“听见／没听清”，不将没听清写成没有振动。",
          "actor": "child",
          "caption": "看到的和听到的分开说。",
          "adultNote": "成人帮记原话，不要求孩子数高频振动次数。"
        }
      ],
      "knowledge": {
        "concepts": [
          "弯着与振动不同",
          "振动：反复来回运动",
          "视觉与听觉证据分开"
        ],
        "explanation": "尺子被保持在一个弯曲位置，和松手后反复来回动不同。振动可以带动周围空气形成声音；声音弱或环境吵时，耳朵未必听得清。",
        "limits": "眼睛很难数清快速来回的次数；这次没有量频率，也不能用“没听见”证明尺子没动。",
        "observation": "静止、保持小弯、松开后的可见运动与听到的声音分别记录。",
        "nextQuestion": "尺子慢慢停下时，看到的运动和听到的声音怎样变化？"
      },
      "guide": {
        "goal": "真实比较静止、保持微弯和自由释放，认识振动而非只看弯曲。",
        "observe": "保持轻弯与松开之后，尺子的运动和声音有什么不同？",
        "support": "成人全部搭设和拨动；孩子在安全位置观察、听、口述。",
        "control": "同一尺、12厘米伸出、同一固定方式，位移不超过约3毫米；比较保持与松开状态。",
        "time": "约5–10分钟。",
        "recordFields": [
          "静止／保持轻弯时看到什么",
          "松开后看到和听到什么",
          "没看清或没听清的地方"
        ]
      },
