{
  "activityId": 51,
  "activityTitle": "称重时盒子的重量去哪了",
  "ageProtocols": {
    "4-6": {
      "version": 1,
      "materials": [
        "厨房电子秤1台（分度1克或更细、量程至少1千克，有说明可查的去皮功能）",
        "无订钉/夹子的同批干燥A4废纸10张（成人逐张对折三次，约7.4×10.5厘米，完整不剪碎）",
        "轻质平底空盒1只（纸叠可完全放入，内底至少约8×11厘米；盒稳放秤台且不触桌）",
        "记录纸2张、笔1支、盒标签；无秤只画装置不填质量数据"
      ],
      "safety": "成人先看秤说明，检查外壳、电池仓盖完好闭合，不拆电池或让儿童碰纽扣电池；秤放干燥水平稳固桌面，远离水，不边充电边操作。只称干净废纸和轻质塑料/纸盒，不称人、动物或贵重物。整套负载须低于秤量程且本活动不超过500克；有超载/不稳定提示就停止，不继续加重。物品居中稳放，不碰桌或手，不压秤；去皮不增加可承载总质量。按说明等稳定后读g，显示不了或不支持所需去皮则记不能完成，不编读数。本龄成人全部放物和按键，孩子只观察指认。",
      "steps": [
        {
          "title": "称空盒，确认盒还在",
          "action": "每轮先拿下全部物品，按说明清除前次去皮并确认空秤为0，记录单位g与最小分度d。只在步骤明确要求时去皮，不能读完不喜欢的数就随意归零。成人把空盒稳放秤上，读数代记。孩子指认“秤上有盒，里面没纸”。",
          "actor": "adult",
          "caption": "称空盒，确认盒还在",
          "adultNote": "实际显示与分度照记，不把差异强行改成零。"
        },
        {
          "title": "盒不拿走，成人去皮",
          "action": "成人依说明对空盒去皮，等待显示；若为0，孩子再指盒仍在。把“显示零”与“盒消失”分开，不把去皮说成盒不再有质量。",
          "actor": "adult",
          "caption": "盒不拿走，成人去皮",
          "adultNote": "实际显示与分度照记，不把差异强行改成零。"
        },
        {
          "title": "同盒内放一叠纸",
          "action": "成人将完整10张折纸放进同盒，等稳读g；不移走盒、不改去皮。孩子描述纸加在哪里和显示变化，成人记录实际数，不说每张纸一定几克。",
          "actor": "adult",
          "caption": "同盒内放一叠纸",
          "adultNote": "实际显示与分度照记，不把差异强行改成零。"
        },
        {
          "title": "只取出纸复查",
          "action": "成人只拿出同纸叠，盒留秤上；记录显示是否回到0附近或有残差，再按说明清除去皮收好。孩子说本次归零的是显示参考而不是盒本身。",
          "actor": "adult",
          "caption": "只取出纸复查",
          "adultNote": "实际显示与分度照记，不把差异强行改成零。"
        }
      ],
      "knowledge": {
        "concepts": [
          "盒与内容物不同",
          "去皮改变显示参考",
          "零显示不等没有物体"
        ],
        "explanation": "去皮把当前空盒当成显示的起点。盒仍在秤上也仍有质量；后来加纸的读数表示相对这个起点增加的量。取出纸可检查显示是否回到原来附近。",
        "limits": "幼儿不需做减法；显示回零可能有分度与漂移影响，不证明秤绝对准确。纸张数不是已知质量标准。",
        "observation": "空盒、盒去皮、加纸、取纸四状态和成人读数。",
        "nextQuestion": "盒还在秤上却显示0，是盒消失了吗？"
      },
      "guide": {
        "goal": "真实空盒去皮—加纸—只取纸，观察物体与显示参考。",
        "observe": "盒不离开秤却显示零，加入再取出同一纸叠时显示和实物分别怎样变化？",
        "support": "成人所有放物按键，孩子指认盒/纸与口述，数字由成人代记。",
        "control": "同一盒10张纸全程不变，只有空盒状态去皮一次，随后只加取纸不按零。",
        "time": "约10分钟。",
        "recordFields": [
          "四状态实物指认",
          "成人记录四次显示g",
          "回零附近/不稳定说明"
        ]
      },
